{
  "id": "com.legrand.homekit.local",
  "sdk": 3,
  "name": "Legrand with HomeKit Code",
  "description": {
    "en": "Local Apple HomeKit integration and Direct Zigbee 3.0 control for Legrand Gateways and Devices"
  },
  "version": "2.1.1",
  "compatibility": ">=5.0.0",
  "author": {
    "name": "Guray Kircuvaloglu"
  },
  "brand": "legrand",
  "brandColor": "#e11a22",
  "category": [
    "lights",
    "appliances",
    "tools"
  ],
  "images": {
    "small": "./assets/images/small.png",
    "large": "./assets/images/large.png"
  },
  "api": {
    "getDiagnostics": {
      "method": "GET",
      "path": "/diagnostics"
    }
  },
  "discovery": {
    "legrand_gateway": {
      "type": "mdns-sd",
      "mdns-sd": {
        "name": "hap",
        "protocol": "tcp"
      }
    }
  },
  "drivers": [
    {
      "id": "legrand_device",
      "name": "Legrand with HomeKit Code",
      "class": "other",
      "capabilities": [
        "onoff",
        "dim",
        "light_hue",
        "light_saturation",
        "light_temperature",
        "windowcoverings_set",
        "windowcoverings_state",
        "measure_temperature",
        "target_temperature",
        "thermostat_mode",
        "measure_humidity"
      ],
      "images": {
        "small": "./drivers/legrand_device/assets/images/small.png",
        "large": "./drivers/legrand_device/assets/images/large.png"
      },
      "discovery": "legrand_gateway",
      "pair": [
        {
          "id": "login_credentials",
          "template": "login_credentials",
          "options": {
            "title": {
              "en": "Legrand Gateway Connection"
            },
            "usernameLabel": {
              "en": "Gateway IP (optional — auto-detected if empty)"
            },
            "passwordLabel": {
              "en": "HomeKit PIN Code (e.g. 123-45-678)"
            },
            "hint": {
              "en": "Leave the IP field empty for auto-discovery. Only fill it if auto-detection fails."
            }
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ]
    },
    {
      "id": "wireless_switch_zigbee",
      "name": {
        "en": "Wireless Switch (Zigbee)"
      },
      "class": "sensor",
      "capabilities": [
        "measure_battery",
        "alarm_battery"
      ],
      "capabilitiesOptions": {
        "measure_battery": {
          "preventInsights": false
